# =============================================================================
# Quanta Foundry - Environment Variables
# =============================================================================

# 1. Database Configuration (Neon Serverless PostgreSQL)
# These should point to your Vercel Marketplace Neon Postgres instance.
DATABASE_URL="postgres://[user]:[password]@[host]/[dbname]?sslmode=require"
SHADOW_DATABASE_URL="postgres://[user]:[password]@[host]/[shadow_dbname]?sslmode=require" # Needed for Prisma migrations

# 2. NextAuth (Auth.js) Configuration
# REQUIRED in EVERY environment, including Vercel. If this is missing or empty,
# Auth.js fails with a generic "There is a problem with the server
# configuration" page and shows no further detail in the browser.
# Run `npx auth secret` to generate a secure random string.
AUTH_SECRET="your_generated_secret_here"

# AUTH_URL — LOCAL DEVELOPMENT ONLY. Do NOT set this in Vercel.
# When AUTH_URL is set, Auth.js rewrites every request's origin to it and
# builds Google's redirect_uri from it, ignoring the host the request actually
# arrived on. A localhost value in production (or any host other than the one
# the user is browsing) scopes the OAuth redirect and the PKCE cookie to
# different origins, which fails with
# "PKCE code_verifier cookie was missing".
# On Vercel, leave AUTH_URL UNSET — the host is detected automatically.
AUTH_URL="http://localhost:3000"

# 3. OAuth Providers (Google)
# Create credentials in the Google Cloud Console
AUTH_GOOGLE_ID="your_google_oauth_client_id"
AUTH_GOOGLE_SECRET="your_google_oauth_client_secret"

# 4. Email Magic Links (Nodemailer)
# SMTP connection string for sending authentication emails
EMAIL_SERVER="smtp://username:password@smtp.example.com:587"
EMAIL_FROM="Quanta Foundry <noreply@quantafoundry.com>"

# 5. Application Flags
# Set to true to enable the prototype session dashboard layout
LEARNING_SESSIONS_PROTOTYPE="true"

# 6. Airtable
# Create a scoped Personal Access Token (NOT a legacy API key) at:
# https://airtable.com/create/tokens
# Scopes: data.records:read, data.records:write
# Access: only the specific bases this app uses.
AIRTABLE_API_KEY="your_airtable_personal_access_token"
AIRTABLE_BASE_ID="your_airtable_base_id"
# Optional — defaults shown below are used if not set
# AIRTABLE_TABLE_NAME="Workspace Q Registrations"
# AIRTABLE_RC_TABLE_NAME="Reading Club Registrations"
# AIRTABLE_CORPORATE_TABLE_NAME="Corporate Inquiries"
