datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  USER
  ADMIN
}

enum EnrollmentRole {
  LEARNER
  INSTRUCTOR
  OBSERVER
}

enum Visibility {
  PUBLIC
  COMMUNITY
  COHORT
}

enum Audience {
  COHORT
  COMMUNITY
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgressState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum LockState {
  DRAFT
  LOCKED
  REOPENED
  VOIDED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  globalRole    GlobalRole   @default(USER)
  /// Set when the person deleted their account (or their only class was cleared): name and email are erased.
  deletedAt     DateTime?
  
  accounts      Account[]
  enrollments   Enrollment[]
  responses     Response[]
  progress      Progress[]
  ownedProjects Project[]    @relation("ProjectOwner")
  memberships   ProjectMember[]
  evaluations   Evaluation[]
  audits        PredictionLockAudit[]
  teamMemberships TeamMember[]
  joinAttempts    JoinAttempt[]
  materialUploads ClassMaterialVersion[]
  activitySubmissions ActivitySubmission[] @relation("ActivitySubmissionOwner")
  activityVersions    ActivitySubmissionVersion[] @relation("ActivityVersionAuthor")
  studentFiles    StudentFile[]        @relation("StudentFileOwner")
  teamAuditsCreated TeamAudit[]        @relation("TeamAuditCreator")
  discussionMessages DiscussionMessage[] @relation("DiscussionAuthor")
  discussionReads    DiscussionRead[]
  fileUploads     StudentFileVersion[] @relation("StudentFileUploader")
  pendingUploads  PendingUpload[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Track {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  domain      String       // quant-finance | applied-ai
  visibility  Visibility
  sessions    Session[]
  offerings   Offering[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Session {
  id                       String           @id @default(cuid())
  trackId                  String
  slug                     String           @unique
  title                    String
  latestPublishedVersionId String?
  
  track                    Track            @relation(fields: [trackId], references: [id])
  versions                 SessionVersion[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([trackId])
}

model SessionVersion {
  id               String            @id @default(cuid())
  sessionId        String
  version          Int
  status           Status            @default(DRAFT)
  contentHash      String            // To detect changes
  schemaVersion    String            // e.g., "1.0.0"
  content          Json              // Validated JSON snapshot
  
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  
  session          Session           @relation(fields: [sessionId], references: [id])
  offeringSessions OfferingSession[]

  @@unique([sessionId, version])
  @@index([sessionId])
}

model Offering {
  id               String            @id @default(cuid())
  trackId          String?
  slug             String            @unique // Stable identifier for idempotent seed upserts
  name             String
  audience         Audience
  visibility       Visibility
  gradingEnabled   Boolean           @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  // Pass code students enter to join this class (null = joining is off).
  // 8 characters from an alphabet without look-alikes; see lib/workspace-classes.ts.
  joinCode          String?           @unique
  joinCodeExpiresAt DateTime?
  // Privacy: the day this class's student data is deleted (set by staff), and when it was.
  // Teaching content (sessions, materials, activities) is kept; see lib/privacy-server.ts.
  dataDeleteAfter   DateTime?
  dataDeletedAt     DateTime?
  
  track            Track?            @relation(fields: [trackId], references: [id])
  enrollments      Enrollment[]
  offeringSessions OfferingSession[]
  milestones       Milestone[]
  teams            Team[]
  teamAudits       TeamAudit[]
  discussions      DiscussionThread[]
  studentFiles     StudentFile[]
  pendingUploads   PendingUpload[]
  auditLogs        WorkspaceAuditLog[]
  classSessions    ClassSession[]
  materials        ClassMaterial[]
  tools            ClassTool[]
  activities       Activity[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([dataDeleteAfter])
}

model Enrollment {
  id         String         @id @default(cuid())
  offeringId String
  userId     String
  role       EnrollmentRole @default(LEARNER)
  
  offering   Offering       @relation(fields: [offeringId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([offeringId, userId])
  @@index([userId])
}

model OfferingSession {
  id                   String         @id @default(cuid())
  offeringId           String
  sessionVersionId     String
  order                Int
  opensAt              DateTime?
  dueAt                DateTime?
  placementOverrides   Json?
  requirementOverrides Json?
  
  offering             Offering       @relation(fields: [offeringId], references: [id])
  sessionVersion       SessionVersion @relation(fields: [sessionVersionId], references: [id])
  progress             Progress[]
  responses            Response[]
  artifacts            Artifact[]
  classSessions        ClassSession[]
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([offeringId, sessionVersionId]) // Ensures connectOrCreate is genuinely idempotent
  @@index([offeringId])
  @@index([sessionVersionId])
}

model Progress {
  id                String          @id @default(cuid())
  userId            String
  offeringSessionId String
  stageId           String
  state             ProgressState   @default(NOT_STARTED)
  
  user              User            @relation(fields: [userId], references: [id])
  offeringSession   OfferingSession @relation(fields: [offeringSessionId], references: [id])
  completedAt       DateTime?
  updatedAt         DateTime        @updatedAt

  @@unique([userId, offeringSessionId, stageId])
  @@index([offeringSessionId])
}

model Response {
  id                String          @id @default(cuid())
  userId            String
  offeringSessionId String
  blockId           String
  value             Json
  lockState         LockState       @default(DRAFT)
  
  user              User            @relation(fields: [userId], references: [id])
  offeringSession   OfferingSession @relation(fields: [offeringSessionId], references: [id])
  lockedAt          DateTime?
  updatedAt         DateTime        @updatedAt
  
  audits            PredictionLockAudit[]

  @@unique([userId, offeringSessionId, blockId])
  @@index([offeringSessionId])
}

model PredictionLockAudit {
  id         String    @id @default(cuid())
  responseId String
  actorId    String
  action     LockState
  reason     String?
  
  response   Response  @relation(fields: [responseId], references: [id])
  actor      User      @relation(fields: [actorId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([responseId])
}

model Project {
  id          String          @id @default(cuid())
  ownerId     String
  title       String
  description String?
  visibility  Visibility      @default(COHORT)
  
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  artifacts   Artifact[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   // OWNER, COLLABORATOR, REVIEWER
  
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Artifact {
  id                           String            @id @default(cuid())
  projectId                    String
  type                         String
  title                        String
  createdFromOfferingSessionId String?
  currentVersionId             String?
  
  project                      Project           @relation(fields: [projectId], references: [id])
  offeringSession              OfferingSession?  @relation(fields: [createdFromOfferingSessionId], references: [id])
  versions                     ArtifactVersion[]
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  @@index([projectId])
}

model ArtifactVersion {
  id         String   @id @default(cuid())
  artifactId String
  version    Int
  content    Json
  
  artifact   Artifact @relation(fields: [artifactId], references: [id])
  createdAt  DateTime @default(now())
  createdBy  String   // User ID

  @@unique([artifactId, version])
}

model Milestone {
  id                    String    @id @default(cuid())
  offeringId            String
  name                  String
  dueAt                 DateTime?
  requiredArtifactTypes String[]  // JSON array of strings
  
  offering              Offering  @relation(fields: [offeringId], references: [id])
  submissions           Submission[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([offeringId])
}

model Submission {
  id                String       @id @default(cuid())
  artifactVersionId String
  milestoneId       String
  state             String       // SUBMITTED, RETURNED, ACCEPTED
  
  milestone         Milestone    @relation(fields: [milestoneId], references: [id])
  evaluations       Evaluation[]
  submittedAt       DateTime     @default(now())
  
  @@index([milestoneId])
  @@index([artifactVersionId])
}

model Evaluation {
  id             String     @id @default(cuid())
  submissionId   String
  evaluatorId    String
  scores         Json?
  comments       Json?
  overallComment String?
  
  submission     Submission @relation(fields: [submissionId], references: [id])
  evaluator      User       @relation(fields: [evaluatorId], references: [id])
  returnedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([submissionId])
}

// ─── Auth.js Required Models ────────────────────────────────────────────────
// Note: We omit the NextAuth Session model to avoid collision with Learning Sessions,
// and because we will use the JWT session strategy.

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// Course materials (the public "Courses" tab)
//
// Deliberately separate from the Track/Session/Offering model above: this is
// a simple download area for slide decks and handouts, managed from
// /courses/admin. Files themselves live in Vercel Blob; these rows hold the
// metadata and the blob URL.
// =============================================================================

enum CourseEventType {
  PAGE_VIEW
  MATERIAL_VIEW
  MATERIAL_DOWNLOAD
}

model Course {
  id          String           @id @default(cuid())
  title       String
  description String?
  order       Int              @default(0)
  isPublished Boolean          @default(true)

  materials   CourseMaterial[]
  events      CourseEvent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([order])
}

model CourseMaterial {
  id           String        @id @default(cuid())
  courseId     String
  title        String
  sessionLabel String?
  fileName     String
  blobUrl      String
  blobPathname String
  contentType  String?
  sizeBytes    Int           @default(0)
  order        Int           @default(0)

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  events       CourseEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([courseId, order])
}

// One row per view / download / page visit. Counts are computed from these
// rows, which also makes "last 7 days" style stats possible. No personal
// data is stored: no user id, no IP address.
model CourseEvent {
  id         String          @id @default(cuid())
  type       CourseEventType
  courseId   String?
  materialId String?

  course     Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  material   CourseMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([materialId, type])
  @@index([type, createdAt])
}

// =============================================================================
// Workspace Q: teams and student files (spec F10 "Files: share work")
//
// A class is an Offering. Teams belong to one class; a student is in at most
// one team per class (enforced by the unique key on TeamMember). Files are
// stored in a PRIVATE Vercel Blob store (its own token, separate from the
// public Courses store) and are only ever served through
// /api/workspace-q/files/<id>/download after a permission check.
// =============================================================================

// Who can see a file, on top of its owner (or team) and the class staff.
enum FileShareLevel {
  STAFF // only the owner and the staff (personal files only)
  TEAM  // the owner's team (personal files) or the team itself (team files)
  CLASS // everyone enrolled in the class
}

model Team {
  id         String        @id @default(cuid())
  offeringId String
  name       String
  order      Int           @default(0)

  offering   Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  members    TeamMember[]
  files      StudentFile[]
  activitySubmissions ActivitySubmission[]
  // Audit pairings set by staff: this team may read the other team's team files.
  auditsGiven    TeamAudit[] @relation("TeamAuditor")
  auditsReceived TeamAudit[] @relation("TeamAudited")
  discussions    DiscussionThread[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Lets members and team files point at (team, class) together, so the
  // database guarantees they belong to the same class as the team.
  @@unique([id, offeringId])
  @@index([offeringId, order])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  // Copied from the team so the database can enforce one team per student per class.
  offeringId String
  userId     String

  team       Team     @relation(fields: [teamId, offeringId], references: [id, offeringId], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([offeringId, userId])
  @@index([teamId])
}

/// Audit pairing, set by staff: members of the auditor team may open the
/// audited team's team files, read-only (current versions only). It gives no
/// access to personal files, earlier versions or activity answers. Removing a
/// pairing, or a student changing team, takes the access away at once.
model TeamAudit {
  id            String   @id @default(cuid())
  offeringId    String
  auditorTeamId String
  auditedTeamId String
  createdById   String?
  createdAt     DateTime @default(now())

  offering  Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  // Both teams point at (team, class), so both must belong to this class.
  auditor   Team     @relation("TeamAuditor", fields: [auditorTeamId, offeringId], references: [id, offeringId], onDelete: Cascade)
  audited   Team     @relation("TeamAudited", fields: [auditedTeamId, offeringId], references: [id, offeringId], onDelete: Cascade)
  createdBy User?    @relation("TeamAuditCreator", fields: [createdById], references: [id], onDelete: SetNull)

  // The migration also adds a CHECK that a team never audits itself.
  @@unique([auditorTeamId, auditedTeamId])
  @@index([auditedTeamId])
  @@index([offeringId])
}

model StudentFile {
  id         String               @id @default(cuid())
  offeringId String
  // The student who created the file. For a team file, the team owns it and
  // this is the member who first uploaded it.
  ownerId    String
  // Set for a team file (shared space of that team); null for a personal file.
  teamId     String?
  title      String
  shareLevel FileShareLevel       @default(STAFF)

  // Restrict: deleting a class or a person must never silently delete student
  // work (or leave its stored files behind); remove their files first.
  offering   Offering             @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  owner      User                 @relation("StudentFileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  team       Team?                @relation(fields: [teamId, offeringId], references: [id, offeringId], onDelete: NoAction)
  // The newest version is the current one; older ones are kept (F10.4).
  versions   StudentFileVersion[]
  discussion DiscussionThread[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([offeringId, shareLevel])
  @@index([teamId])
  @@index([ownerId])
}

model StudentFileVersion {
  id           String      @id @default(cuid())
  fileId       String
  blobPathname String      @unique
  fileName     String
  contentType  String?
  sizeBytes    Int
  uploadedById String

  file         StudentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy   User        @relation("StudentFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  activityAttachments ActivitySubmissionFile[]
  createdAt    DateTime    @default(now())

  @@index([fileId, createdAt])
}

// An upload that was granted a token but not saved yet. Saving requires the
// row (so only the student who started an upload can save it); rows older
// than an hour are swept, and their stored file deleted, so abandoned
// uploads don't take up space.
model PendingUpload {
  id           String   @id @default(cuid())
  offeringId   String
  userId       String
  blobPathname String   @unique

  offering     Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Who did what, when (spec: every change of team or visibility is logged).
model WorkspaceAuditLog {
  id         String   @id @default(cuid())
  offeringId String
  actorId    String
  action     String   // e.g. file.upload, file.share, file.delete, team.assign
  entity     String   // StudentFile | Team | TeamMember
  entityId   String
  details    Json?

  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([offeringId, createdAt])
}

/// One try at joining a class with a pass code. Wrong tries are counted to
/// slow down anyone guessing codes (5 wrong in 15 minutes locks that person out).
model JoinAttempt {
  id        String   @id @default(cuid())
  userId    String
  success   Boolean
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// =============================================================================
// Workspace Q: class sessions, materials library and tools (spec F1.3, F4, F5)
//
// A ClassSession is one meeting of a class (number, EN/FR title, date, room,
// release time for its materials). It may point to an interactive learning
// session (OfferingSession) but does not need one. Materials live in the same
// PRIVATE Blob store as student files (path materials/<offeringId>/<uuid>/<name>)
// and are only served by /api/workspace-q/materials/<id>/file after a check.
// =============================================================================

enum MaterialKind {
  DECK      // HTML slide deck, opens full screen
  PREREAD   // HTML or PDF reading
  NOTEBOOK  // .ipynb, with Open in Colab when a GitHub URL is set
  DATASET   // CSV / XLSX, with an optional unguessable link for notebooks
  DOCUMENT  // DOCX, PDF, anything else
  LINK      // external address, no file
}

enum MaterialLanguage {
  EN
  FR
  BOTH
}

enum MaterialAudience {
  STUDENTS
  STAFF
}

model ClassSession {
  id                 String           @id @default(cuid())
  offeringId         String
  number             Int
  titleEn            String
  titleFr            String?
  startsAt           DateTime?
  room               String?
  /// Materials of this session become visible to students at this time (null = at once).
  materialsReleaseAt DateTime?
  offeringSessionId  String?

  offering           Offering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  offeringSession    OfferingSession? @relation(fields: [offeringSessionId], references: [id], onDelete: SetNull)
  materials          ClassMaterial[]
  activities         Activity[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([id, offeringId])
  @@index([offeringId, number])
}

model ClassMaterial {
  id           String           @id @default(cuid())
  offeringId   String
  /// null = general material of the class, not tied to one session
  sessionId    String?
  kind         MaterialKind
  titleEn      String
  titleFr      String?
  language     MaterialLanguage @default(BOTH)
  audience     MaterialAudience @default(STUDENTS)
  /// Overrides the session's release time (null = follow the session).
  releaseAt    DateTime?
  downloadable Boolean          @default(true)
  /// LINK materials only
  externalUrl  String?
  /// NOTEBOOK: the notebook on public GitHub, for Open in Colab
  githubUrl    String?
  /// DATASET: long random token for a read-only link notebooks can use (null = no link)
  publicToken  String?          @unique
  order        Int              @default(0)

  offering     Offering         @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  // Composite key: a material can only belong to a session of the same class.
  session      ClassSession?    @relation(fields: [sessionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  versions     ClassMaterialVersion[]
  modelFor     Activity[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([offeringId, sessionId, order])
}

model ClassMaterialVersion {
  id           String        @id @default(cuid())
  materialId   String
  fileName     String
  blobPathname String        @unique
  contentType  String?
  sizeBytes    Int
  uploadedById String

  material     ClassMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  uploadedBy   User          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())

  @@index([materialId, createdAt])
}

/// Links students need all term (Colab, the course GitHub, a Python primer…).
model ClassTool {
  id         String   @id @default(cuid())
  offeringId String
  label      String
  url        String
  order      Int      @default(0)

  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([offeringId, order])
}

// =============================================================================
// Workspace Q: activities, the virtual handouts (spec F6, part A)
//
// An Activity belongs to a class (and usually a session). A team or a student
// fills in ONE ActivitySubmission per activity (ownerKey "team:<id>" or
// "user:<id>"); `answers` is the current state, and every save is kept as an
// ActivitySubmissionVersion with its author (consecutive saves by the same
// person within a couple of minutes update the same version). Files are
// student files (F10): attaching one points at a StudentFileVersion, which
// then can't be deleted while it is attached.
// =============================================================================

enum ActivityKind {
  SHORT_ANSWER
  FORM
  FILE
  LINK
  QUIZ
  CARD_SORT
}

enum ActivitySubmitter {
  TEAM
  INDIVIDUAL
}

model Activity {
  id             String            @id @default(cuid())
  offeringId     String
  sessionId      String?
  kind           ActivityKind
  submitter      ActivitySubmitter @default(TEAM)
  titleEn        String
  titleFr        String?
  instructionsEn String            @default("")
  instructionsFr String?
  /// Questions (short answers) or fields (structured form); see lib/workspace-activities.ts
  config         Json              @default("{}")
  /// Students see it only once it is published
  visible        Boolean           @default(false)
  opensAt        DateTime?
  dueAt          DateTime?
  allowLate      Boolean           @default(true)
  order          Int               @default(0)
  /// Quiz and card sort: when "show results" is set to "when I decide", the moment you did
  resultsRevealedAt DateTime?
  /// A material of the class holding the model answer (F6.4); its own audience and release decide who sees it
  modelMaterialId String?
  modelMaterial   ClassMaterial?   @relation(fields: [modelMaterialId], references: [id], onDelete: SetNull)

  offering       Offering          @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  session        ClassSession?     @relation(fields: [sessionId, offeringId], references: [id, offeringId], onDelete: Restrict)
  submissions    ActivitySubmission[]
  discussions    DiscussionThread[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([id, offeringId])
  @@index([offeringId, sessionId, order])
}

model ActivitySubmission {
  id            String    @id @default(cuid())
  activityId    String
  offeringId    String
  teamId        String?
  userId        String?
  /// "team:<teamId>" or "user:<userId>": one submission per team or student
  ownerKey      String
  answers       Json      @default("{}")
  submittedAt   DateTime?
  lastSavedAt   DateTime  @default(now())
  lastSavedById String?

  activity      Activity  @relation(fields: [activityId, offeringId], references: [id, offeringId], onDelete: Cascade)
  // Restrict: a team or a person with submitted work can't silently disappear.
  team          Team?     @relation(fields: [teamId, offeringId], references: [id, offeringId], onDelete: Restrict)
  user          User?     @relation("ActivitySubmissionOwner", fields: [userId], references: [id], onDelete: Restrict)
  versions      ActivitySubmissionVersion[]
  files         ActivitySubmissionFile[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([activityId, ownerKey])
  @@index([offeringId])
}

model ActivitySubmissionVersion {
  id           String             @id @default(cuid())
  submissionId String
  authorId     String
  answers      Json

  submission   ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  author       User               @relation("ActivityVersionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([submissionId, createdAt])
}

/// A student file version attached to a submission. Restrict keeps the file
/// (and its stored copy) from being deleted while it is attached.
model ActivitySubmissionFile {
  id            String             @id @default(cuid())
  submissionId  String
  fileVersionId String

  submission    ActivitySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileVersion   StudentFileVersion @relation(fields: [fileVersionId], references: [id], onDelete: Restrict)
  createdAt     DateTime           @default(now())

  @@unique([submissionId, fileVersionId])
  @@index([fileVersionId])
}

// =============================================================================
// Team discussion threads: a team board, comments on a file, comments on an
// activity answer. Readable only by the people the thing belongs to (the team,
// or the student) and the class staff. See lib/discussions.ts.
// =============================================================================

enum DiscussionKind {
  TEAM
  FILE
  ACTIVITY
}

model DiscussionThread {
  id            String         @id @default(cuid())
  offeringId    String
  kind          DiscussionKind
  /// "team:<teamId>", "file:<fileId>" or "activity:<activityId>:<ownerKey>": one thread per thing
  targetKey     String         @unique
  /// TEAM threads, and ACTIVITY threads of a team answer
  teamId        String?
  /// FILE threads
  fileId        String?
  /// ACTIVITY threads, with whose answer it is ("team:<id>" or "user:<id>")
  activityId    String?
  ownerKey      String?
  lastMessageAt DateTime?
  createdAt     DateTime       @default(now())

  offering Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  // NoAction: a team whose discussion has messages can't be deleted (see deleteTeam).
  team     Team?         @relation(fields: [teamId, offeringId], references: [id, offeringId], onDelete: NoAction)
  // Comments go with the file or the activity they are about.
  file     StudentFile?  @relation(fields: [fileId], references: [id], onDelete: Cascade)
  activity Activity?     @relation(fields: [activityId, offeringId], references: [id, offeringId], onDelete: Cascade)
  messages DiscussionMessage[]
  reads    DiscussionRead[]

  @@index([offeringId, kind])
  @@index([teamId])
  @@index([fileId])
  @@index([activityId])
}

model DiscussionMessage {
  id          String    @id @default(cuid())
  threadId    String
  authorId    String
  /// Plain text; emptied when the message is deleted
  body        String
  /// Both set by the server's clock (not the database's) so polling can compare them safely
  createdAt   DateTime
  updatedAt   DateTime
  deletedAt   DateTime?
  deletedById String?

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  // Restrict: a person who wrote messages can't silently disappear.
  author User             @relation("DiscussionAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([threadId, updatedAt])
  @@index([threadId, createdAt])
  @@index([authorId, createdAt])
}

/// Up to when each person has read a thread (for "new" counts).
model DiscussionRead {
  threadId   String
  userId     String
  lastReadAt DateTime

  thread DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([threadId, userId])
  @@index([userId])
}
