datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum GlobalRole {
  USER
  ADMIN
}

enum EnrollmentRole {
  LEARNER
  INSTRUCTOR
  OBSERVER
}

enum Visibility {
  PUBLIC
  COMMUNITY
  COHORT
}

enum Audience {
  COHORT
  COMMUNITY
}

enum Status {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgressState {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum LockState {
  DRAFT
  LOCKED
  REOPENED
  VOIDED
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  globalRole    GlobalRole   @default(USER)
  
  accounts      Account[]
  enrollments   Enrollment[]
  responses     Response[]
  progress      Progress[]
  ownedProjects Project[]    @relation("ProjectOwner")
  memberships   ProjectMember[]
  evaluations   Evaluation[]
  audits        PredictionLockAudit[]
  teamMemberships TeamMember[]
  studentFiles    StudentFile[]        @relation("StudentFileOwner")
  fileUploads     StudentFileVersion[] @relation("StudentFileUploader")
  pendingUploads  PendingUpload[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Track {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  domain      String       // quant-finance | applied-ai
  visibility  Visibility
  sessions    Session[]
  offerings   Offering[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Session {
  id                       String           @id @default(cuid())
  trackId                  String
  slug                     String           @unique
  title                    String
  latestPublishedVersionId String?
  
  track                    Track            @relation(fields: [trackId], references: [id])
  versions                 SessionVersion[]
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  @@index([trackId])
}

model SessionVersion {
  id               String            @id @default(cuid())
  sessionId        String
  version          Int
  status           Status            @default(DRAFT)
  contentHash      String            // To detect changes
  schemaVersion    String            // e.g., "1.0.0"
  content          Json              // Validated JSON snapshot
  
  publishedAt      DateTime?
  createdAt        DateTime          @default(now())
  
  session          Session           @relation(fields: [sessionId], references: [id])
  offeringSessions OfferingSession[]

  @@unique([sessionId, version])
  @@index([sessionId])
}

model Offering {
  id               String            @id @default(cuid())
  trackId          String?
  slug             String            @unique // Stable identifier for idempotent seed upserts
  name             String
  audience         Audience
  visibility       Visibility
  gradingEnabled   Boolean           @default(false)
  startsAt         DateTime?
  endsAt           DateTime?
  
  track            Track?            @relation(fields: [trackId], references: [id])
  enrollments      Enrollment[]
  offeringSessions OfferingSession[]
  milestones       Milestone[]
  teams            Team[]
  studentFiles     StudentFile[]
  pendingUploads   PendingUpload[]
  auditLogs        WorkspaceAuditLog[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Enrollment {
  id         String         @id @default(cuid())
  offeringId String
  userId     String
  role       EnrollmentRole @default(LEARNER)
  
  offering   Offering       @relation(fields: [offeringId], references: [id])
  user       User           @relation(fields: [userId], references: [id])
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([offeringId, userId])
  @@index([userId])
}

model OfferingSession {
  id                   String         @id @default(cuid())
  offeringId           String
  sessionVersionId     String
  order                Int
  opensAt              DateTime?
  dueAt                DateTime?
  placementOverrides   Json?
  requirementOverrides Json?
  
  offering             Offering       @relation(fields: [offeringId], references: [id])
  sessionVersion       SessionVersion @relation(fields: [sessionVersionId], references: [id])
  progress             Progress[]
  responses            Response[]
  artifacts            Artifact[]
  
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@unique([offeringId, sessionVersionId]) // Ensures connectOrCreate is genuinely idempotent
  @@index([offeringId])
  @@index([sessionVersionId])
}

model Progress {
  id                String          @id @default(cuid())
  userId            String
  offeringSessionId String
  stageId           String
  state             ProgressState   @default(NOT_STARTED)
  
  user              User            @relation(fields: [userId], references: [id])
  offeringSession   OfferingSession @relation(fields: [offeringSessionId], references: [id])
  completedAt       DateTime?
  updatedAt         DateTime        @updatedAt

  @@unique([userId, offeringSessionId, stageId])
  @@index([offeringSessionId])
}

model Response {
  id                String          @id @default(cuid())
  userId            String
  offeringSessionId String
  blockId           String
  value             Json
  lockState         LockState       @default(DRAFT)
  
  user              User            @relation(fields: [userId], references: [id])
  offeringSession   OfferingSession @relation(fields: [offeringSessionId], references: [id])
  lockedAt          DateTime?
  updatedAt         DateTime        @updatedAt
  
  audits            PredictionLockAudit[]

  @@unique([userId, offeringSessionId, blockId])
  @@index([offeringSessionId])
}

model PredictionLockAudit {
  id         String    @id @default(cuid())
  responseId String
  actorId    String
  action     LockState
  reason     String?
  
  response   Response  @relation(fields: [responseId], references: [id])
  actor      User      @relation(fields: [actorId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([responseId])
}

model Project {
  id          String          @id @default(cuid())
  ownerId     String
  title       String
  description String?
  visibility  Visibility      @default(COHORT)
  
  owner       User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  members     ProjectMember[]
  artifacts   Artifact[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([ownerId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   // OWNER, COLLABORATOR, REVIEWER
  
  project   Project  @relation(fields: [projectId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

model Artifact {
  id                           String            @id @default(cuid())
  projectId                    String
  type                         String
  title                        String
  createdFromOfferingSessionId String?
  currentVersionId             String?
  
  project                      Project           @relation(fields: [projectId], references: [id])
  offeringSession              OfferingSession?  @relation(fields: [createdFromOfferingSessionId], references: [id])
  versions                     ArtifactVersion[]
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt

  @@index([projectId])
}

model ArtifactVersion {
  id         String   @id @default(cuid())
  artifactId String
  version    Int
  content    Json
  
  artifact   Artifact @relation(fields: [artifactId], references: [id])
  createdAt  DateTime @default(now())
  createdBy  String   // User ID

  @@unique([artifactId, version])
}

model Milestone {
  id                    String    @id @default(cuid())
  offeringId            String
  name                  String
  dueAt                 DateTime?
  requiredArtifactTypes String[]  // JSON array of strings
  
  offering              Offering  @relation(fields: [offeringId], references: [id])
  submissions           Submission[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([offeringId])
}

model Submission {
  id                String       @id @default(cuid())
  artifactVersionId String
  milestoneId       String
  state             String       // SUBMITTED, RETURNED, ACCEPTED
  
  milestone         Milestone    @relation(fields: [milestoneId], references: [id])
  evaluations       Evaluation[]
  submittedAt       DateTime     @default(now())
  
  @@index([milestoneId])
  @@index([artifactVersionId])
}

model Evaluation {
  id             String     @id @default(cuid())
  submissionId   String
  evaluatorId    String
  scores         Json?
  comments       Json?
  overallComment String?
  
  submission     Submission @relation(fields: [submissionId], references: [id])
  evaluator      User       @relation(fields: [evaluatorId], references: [id])
  returnedAt     DateTime?
  createdAt      DateTime   @default(now())

  @@index([submissionId])
}

// ─── Auth.js Required Models ────────────────────────────────────────────────
// Note: We omit the NextAuth Session model to avoid collision with Learning Sessions,
// and because we will use the JWT session strategy.

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =============================================================================
// Course materials (the public "Courses" tab)
//
// Deliberately separate from the Track/Session/Offering model above: this is
// a simple download area for slide decks and handouts, managed from
// /courses/admin. Files themselves live in Vercel Blob; these rows hold the
// metadata and the blob URL.
// =============================================================================

enum CourseEventType {
  PAGE_VIEW
  MATERIAL_VIEW
  MATERIAL_DOWNLOAD
}

model Course {
  id          String           @id @default(cuid())
  title       String
  description String?
  order       Int              @default(0)
  isPublished Boolean          @default(true)

  materials   CourseMaterial[]
  events      CourseEvent[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([order])
}

model CourseMaterial {
  id           String        @id @default(cuid())
  courseId     String
  title        String
  sessionLabel String?
  fileName     String
  blobUrl      String
  blobPathname String
  contentType  String?
  sizeBytes    Int           @default(0)
  order        Int           @default(0)

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  events       CourseEvent[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([courseId, order])
}

// One row per view / download / page visit. Counts are computed from these
// rows, which also makes "last 7 days" style stats possible. No personal
// data is stored: no user id, no IP address.
model CourseEvent {
  id         String          @id @default(cuid())
  type       CourseEventType
  courseId   String?
  materialId String?

  course     Course?         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  material   CourseMaterial? @relation(fields: [materialId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())

  @@index([materialId, type])
  @@index([type, createdAt])
}

// =============================================================================
// Workspace Q: teams and student files (spec F10 "Files: share work")
//
// A class is an Offering. Teams belong to one class; a student is in at most
// one team per class (enforced by the unique key on TeamMember). Files are
// stored in a PRIVATE Vercel Blob store (its own token, separate from the
// public Courses store) and are only ever served through
// /api/workspace-q/files/<id>/download after a permission check.
// =============================================================================

// Who can see a file, on top of its owner (or team) and the class staff.
enum FileShareLevel {
  STAFF // only the owner and the staff (personal files only)
  TEAM  // the owner's team (personal files) or the team itself (team files)
  CLASS // everyone enrolled in the class
}

model Team {
  id         String        @id @default(cuid())
  offeringId String
  name       String
  order      Int           @default(0)

  offering   Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  members    TeamMember[]
  files      StudentFile[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  // Lets members and team files point at (team, class) together, so the
  // database guarantees they belong to the same class as the team.
  @@unique([id, offeringId])
  @@index([offeringId, order])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  // Copied from the team so the database can enforce one team per student per class.
  offeringId String
  userId     String

  team       Team     @relation(fields: [teamId, offeringId], references: [id, offeringId], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([offeringId, userId])
  @@index([teamId])
}

model StudentFile {
  id         String               @id @default(cuid())
  offeringId String
  // The student who created the file. For a team file, the team owns it and
  // this is the member who first uploaded it.
  ownerId    String
  // Set for a team file (shared space of that team); null for a personal file.
  teamId     String?
  title      String
  shareLevel FileShareLevel       @default(STAFF)

  // Restrict: deleting a class or a person must never silently delete student
  // work (or leave its stored files behind); remove their files first.
  offering   Offering             @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  owner      User                 @relation("StudentFileOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  team       Team?                @relation(fields: [teamId, offeringId], references: [id, offeringId], onDelete: NoAction)
  // The newest version is the current one; older ones are kept (F10.4).
  versions   StudentFileVersion[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([offeringId, shareLevel])
  @@index([teamId])
  @@index([ownerId])
}

model StudentFileVersion {
  id           String      @id @default(cuid())
  fileId       String
  blobPathname String      @unique
  fileName     String
  contentType  String?
  sizeBytes    Int
  uploadedById String

  file         StudentFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy   User        @relation("StudentFileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  createdAt    DateTime    @default(now())

  @@index([fileId, createdAt])
}

// An upload that was granted a token but not saved yet. Saving requires the
// row (so only the student who started an upload can save it); rows older
// than an hour are swept, and their stored file deleted, so abandoned
// uploads don't take up space.
model PendingUpload {
  id           String   @id @default(cuid())
  offeringId   String
  userId       String
  blobPathname String   @unique

  offering     Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Who did what, when (spec: every change of team or visibility is logged).
model WorkspaceAuditLog {
  id         String   @id @default(cuid())
  offeringId String
  actorId    String
  action     String   // e.g. file.upload, file.share, file.delete, team.assign
  entity     String   // StudentFile | Team | TeamMember
  entityId   String
  details    Json?

  offering   Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([offeringId, createdAt])
}
